# Local DB by default. For Supabase use postgresql+psycopg://... with a pooled connection.
DATABASE_URL=sqlite:///./finn.db
CORS_ORIGINS=http://localhost:3000
# Hosted AI. Gemini has OpenAI-compatible endpoint; leave blank for evidence-only operation.
GEMINI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Optional secret for protected ingestion endpoint. Without this, use the Python CLI.
INGEST_TOKEN=
MAX_PDF_BYTES=14000000
